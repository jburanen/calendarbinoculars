# Local development: serves this clone live, so edits to index.html show up on refresh.
#   cp docker-compose.yml.example docker-compose.yml && docker compose up -d
# For deployment, use the release-image compose file in the README instead.
services:
    calbinocs:
        container_name: nginx-calbinocs
        image: nginx:stable-alpine
        restart: unless-stopped
        ports:
            - 8082:80
        volumes:
            # Mount individual files only. Mounting the whole folder would serve .git too.
            - ./index.html:/usr/share/nginx/html/index.html:ro
            - ./favicon.ico:/usr/share/nginx/html/favicon.ico:ro
            # Optional. Create config.yaml first, or Docker makes an empty directory named config.yaml.
            # - ./config.yaml:/usr/share/nginx/html/config.yaml:ro
